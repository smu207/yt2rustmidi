{
  "name": "yt2midi-web",
  "version": "1.0.0",
  "private": true,
  "description": "브라우저에서 노래를 악기별로 분리하고 MIDI로 변환·편집하는 웹페이지",
  "scripts": {
    "build": "esbuild src/pipeline.js --bundle --minify --format=iife --global-name=YT2MIDI --target=es2020 --outfile=app.bundle.js && node scripts/copy-model.js",
    "serve": "python3 -m http.server 8080"
  },
  "dependencies": {
    "@spotify/basic-pitch": "1.0.1",
    "demucs-web": "1.0.2"
  },
  "devDependencies": {
    "esbuild": "0.24.0"
  }
}
